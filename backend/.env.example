# Copie este arquivo para .env e preencha com valores reais

# String de conexão do PostgreSQL (local ou Neon/Supabase em produção)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/tcc_guidance"

# Texto secreto usado para assinar os tokens JWT (qualquer string longa e aleatória)
JWT_SECRET="troque_isso_por_um_texto_secreto_qualquer"

# URL do frontend, usada para liberar CORS e Socket.io
# Em dev: http://localhost:5173 (padrão do Vite, opcional)
# Em produção: URL da Vercel, ex: https://seu-projeto.vercel.app
FRONTEND_URL="http://localhost:5173"

# Porta do servidor (hosts como Render/Railway definem automaticamente)
# PORT=3333
